# Anthropic API key, from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: model used for translation and lessons.
#   claude-sonnet-5             - default, best quality/cost balance
#   claude-haiku-4-5-20251001   - about a third of the price and faster, and
#                                 still passes the lesson checks
CLAUDE_MODEL=claude-sonnet-5

# Optional: sentences longer than this are refused rather than translated,
# so one pasted wall of text cannot run up the bill.
MAX_INPUT_CHARS=2000

# Optional: how much explanation rides along with each translation on the
# translator page.
#   full     - break the whole translation down chunk by chunk, paired back to
#              the original wording. Roughly doubles output tokens per message.
#   beginner - pick out at most 3 common words worth learning first, highlight
#              them in the translation, and explain only those
#   off      - just the translation
EXPLAIN_TRANSLATIONS=full

# Optional: the port the site is served on.
WEB_PORT=3000

# Optional: the host the site should be reached at, e.g. languageballs.com.
# Requests arriving under any other name are redirected there with a 301.
# Leave empty in development.
CANONICAL_HOST=

# Optional: the languages the translator page starts with. Comma-separated,
# and changeable per request in the page itself.
WEB_TARGETS=English, Norwegian

# Optional: Azure Speech, so the learn page can read Turkish aloud with a
# proper voice. Create a "Speech" resource in the Azure portal and copy one of
# its keys and its region (e.g. westeurope). Without these the page falls back
# to the browser's own voice.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional: which voices. Turkish: tr-TR-AhmetNeural (male) or
# tr-TR-EmelNeural (female) read exactly what they are given. The MAI voices
# tr-TR-Elif:MAI-Voice-2 and tr-TR-Aydın:MAI-Voice-2 (and their cheaper
# -Flash variants) sound richer but act out a mood of their own, laughs
# included. Norwegian: nb-NO-PernilleNeural (female), nb-NO-IselinNeural
# (female) or nb-NO-FinnNeural (male).
AZURE_SPEECH_VOICE=tr-TR-AhmetNeural
AZURE_SPEECH_VOICE_NB=nb-NO-PernilleNeural
# Optional: a speaking style for the MAI voices, which otherwise act out a
# mood of their own and may laugh at a lone word. Elif takes: adventurous,
# caring, empathy, curious, encouraging, excited, friendly, cheerful,
# nostalgic, reflective, sad, disappointed, serious. Empty for none.
SPEECH_STYLE=serious
# Optional: where generated audio is kept so each sentence is fetched once.
SPEECH_CACHE_DIR=data/speech

# Pictures beside nouns on the learn page need no key: the emoji set ships
# with the server, and ARASAAC's pictograms are fetched once and kept on disk.
# Optional: Recraft (recraft.ai) draws the nouns neither source covers, but
# only with RECRAFT_ENABLED=true, since each drawing costs money: about $0.08
# with the vector model, half that with the raster one (recraftv4_1).
RECRAFT_ENABLED=false
RECRAFT_API_KEY=
RECRAFT_MODEL=recraftv4_1_vector
# Optional: a style made in Recraft from reference images, so every drawing
# looks like the same artist's.
RECRAFT_STYLE_ID=
PICTURE_CACHE_DIR=data/pictures
# Optional: how many new drawings a day at most. A spending guard.
PICTURE_DAILY_CAP=300
# Optional: the SQLite file generated lessons are pooled in, so a sentence made
# for one learner is served from disk to the next. Logged-in learners' chests
# live here too. Set to "off" to always ask the model and disable login.
LESSON_DB=data/lessons.db

# Optional: Sign in with Google, so a learner's chest and history follow them
# between devices. Create an OAuth client (type "Web application") in Google
# Cloud -> APIs & Services -> Credentials, with these authorised redirect URIs:
#   https://languageballs.com/auth/google/callback
#   http://localhost:3000/auth/google/callback
# Without both values the login button is not shown.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: signs the session cookie. Any long random string. Without it a
# random one is made at start-up, so everyone is logged out by a restart.
SESSION_SECRET=
# Optional: the ball's delivery. Pitch and rate in Azure SSML form. Big pitch
# shifts ("+20%") sound like a small ball but blur consonants, so the default
# is the natural pitch at a slower, learner-friendly pace.
SPEECH_PITCH=+0%
SPEECH_RATE=-15%
