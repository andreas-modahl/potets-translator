# Discord bot token, from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Anthropic API key, from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: register slash commands to a single guild instead of globally.
# Guild commands appear instantly; global commands can take up to an hour to
# propagate. Use this while developing, leave empty in production.
DISCORD_GUILD_ID=

# Optional: model used for translation.
#   claude-sonnet-5             - default, best quality/cost balance
#   claude-haiku-4-5-20251001   - cheaper and faster, fine for short chat messages
CLAUDE_MODEL=claude-sonnet-5

# Optional: messages longer than this are skipped rather than translated,
# so one pasted wall of text cannot run up the bill.
MAX_INPUT_CHARS=2000

# Optional: how translations are posted by default.
#   plain   - an ordinary message in the channel, attached to nothing
#   reply   - the bot replies to the original message
#   thread  - in a thread hanging off the original message, named with the
#             target language flag (needs Create Public Threads)
#   webhook - reposted under the original author's name and avatar (needs the
#             Manage Webhooks permission)
# Anything unavailable falls back to reply.
DEFAULT_POST_MODE=plain

# Optional: how much explanation rides along with each translation.
#   full     - break the whole translation down chunk by chunk, paired back to
#              the original wording. Roughly doubles output tokens per message.
#   beginner - pick out at most 3 common words worth learning first, highlight
#              them in the translation, and explain only those
#   off      - just the translation
EXPLAIN_TRANSLATIONS=full

# Optional: where per-channel configuration is persisted.
DATA_FILE=data/channels.json

# Optional: the web app (npm run web). It needs only ANTHROPIC_API_KEY, and
# shares MAX_INPUT_CHARS, CLAUDE_MODEL and EXPLAIN_TRANSLATIONS with the bot.
WEB_PORT=3000

# Optional: the languages the web page starts with. Comma-separated, and
# changeable per request in the page itself.
WEB_TARGETS=English, Norwegian
