# Discord bot token, from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Anthropic API key, from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: register slash commands to a single guild instead of globally.
# Guild commands appear instantly; global commands can take up to an hour to
# propagate. Use this while developing, leave empty in production.
DISCORD_GUILD_ID=

# Optional: model used for translation.
#   claude-sonnet-5             - default, best quality/cost balance
#   claude-haiku-4-5-20251001   - cheaper and faster, fine for short chat messages
CLAUDE_MODEL=claude-sonnet-5

# Optional: messages longer than this are skipped rather than translated,
# so one pasted wall of text cannot run up the bill.
MAX_INPUT_CHARS=2000

# Optional: how translations are posted by default.
#   webhook - reposted under the original author's name and avatar (needs the
#             Manage Webhooks permission; falls back to reply if missing)
#   reply   - the bot replies to the original message
DEFAULT_POST_MODE=webhook

# Optional: where per-channel configuration is persisted.
DATA_FILE=data/channels.json
