{
  "name": "potets-translator",
  "version": "0.1.0",
  "private": true,
  "description": "languageballs.com: a learn-a-language web app built on Claude",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "web": "node --watch --watch-path=src --watch-path=.env --watch-preserve-output --import tsx src/server.ts",
    "web:start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify/utils": "^3.1.6",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
